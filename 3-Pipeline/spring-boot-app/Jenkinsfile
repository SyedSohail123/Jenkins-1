pipeline {
    agent {
        docker {
            image 'syedsohail321/alpine-java-11-maven:v1'
            args '--user root -v /var/run/docker.sock:/var/run/docker.sock -v $HOME/.m2:/root/.m2' // mount Docker socket to access the host's Docker daemon
        }
    }
    stages {
        stage ('Checkout') {
            steps {
                sh 'echo passed'
            }
        }
        stage ('Build and Test') {
            steps {
                sh 'cd 3-Pipeline/spring-boot-app && mvn clean package'
            }
        }
        stage ('Static Code Analysis') {
            environment {
                SONAR_URL = ""
            }
            steps {
                withCredentials([string(credentialsId: 'sonarqube', variable: 'SONAR_AUTH_TOKEN')]) {
                    sh 'cd 3-Pipeline/spring-boot-app && mvn sonar:sonar -Dsonar.token=${SONAR_AUTH_TOKEN} -Dsonar.host.url=${SONAR_URL}'
                }
            }
        }
        stage ('Build and Push Docker Image') {
            environment {
                DOCKER_IMAGE = "syedsohail321/jenkins-java-app:${BUILD_NUMBER}"
            }
            steps {
                script {
                    sh 'cd 3-Pipeline/spring-boot-app && docker image build -t ${DOCKER_IMAGE} .'
                    def dockerImage = docker.image("${DOCKER_IMAGE}")
                    docker.withRegistry('https://index.docker.io/v1/', "docker-cred") {
                        dockerImage.push()
                    }
                }
            }
        }
        stage ('Update the Deployment File') {
            environment {
                GIT_REPO_NAME = "Jenkins-1"
                GIT_USER_NAME = "SyedSohail123"
            }
            steps {
                withCredentials([string(credentialsId: 'github', variable: 'GITHUB_TOKEN')]) {
                    sh '''
                        git config user.email "sohail.xyz@gmail.com"
                        git config user.name "Syed Sohail"
                        git pull --rebase https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git main
                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" 3-Pipeline/spring-boot-app-manifests/deployment.yml
                        git add 3-Pipeline/spring-boot-app-manifests/deployment.yml
                        git commit -m "Update deployment image to version ${BUILD_NUMBER}"
                        git push https://${GITHUB_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME} HEAD:main 
                    '''
                }
            }
        }
    }
    post {
        always {
            cleanWs()
    }
  }
}